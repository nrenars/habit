<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HabitManager.Maui.Views.EditHabit"
             Title="{Binding Name}">

    <VerticalStackLayout>

        <Entry Text="{Binding Name}" />
        <Entry Text="{Binding Note}" />
        <Entry Text="{Binding HabitFrequency}" />

        <Button Grid.Row="0" x:Name="SaveChangesButton" Text="Save" HorizontalOptions="Center" Clicked="OnSaveButtonClicked" />

    </VerticalStackLayout>

</ContentPage>
