<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HabitManager.Maui.Views.HabitDetails"
             Title="{Binding Name, StringFormat='Editing {0}'}">

    <VerticalStackLayout>

        <VerticalStackLayout Padding="20">

            <Label Text="{Binding Name}" FontSize="24" FontAttributes="Bold" />
            <Label Text="{Binding Note}" />
            <Label Text="{Binding HabitFrequency}" />
            <Label Text="{Binding Status}" />
            <Label Text="{Binding Completions.Count, StringFormat='Izpildes: {0}'}" />
            <ImageButton Source="Resources/Images/edit.png" Grid.Row="0" x:Name="EditHabitButton" Text="Edit" HorizontalOptions="Center" Clicked="OnEditButtonClicked" />

        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentPage>
