<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HabitManager.Maui.Views.HabitList"
             Title="Habits">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,16,20,4">
            <Label Text="My habits" Style="{StaticResource Title}" VerticalOptions="Center" />
            <Button Grid.Column="1" x:Name="NewHabitButton" Text="+ New"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="40" Padding="18,0" Clicked="OnNewHabitClicked" />
        </Grid>

        <CollectionView Grid.Row="1" x:Name="HabitsView"
                        SelectionMode="Single" SelectionChanged="OnHabitSelected">

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" Spacing="8" Padding="40">
                    <Label Text="No habits yet" Style="{StaticResource CardTitle}"
                           HorizontalOptions="Center" />
                    <Label Text="Tap “+ New” to add your first one."
                           Style="{StaticResource Muted}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6">

                            <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                            <Label Text="{Binding Note}" Style="{StaticResource Muted}" />
                            <Label Text="{Binding ScheduledDays}" Style="{StaticResource Muted}" />

                            <HorizontalStackLayout Spacing="8">
                                <Border Style="{StaticResource Badge}">
                                    <Label Text="{Binding Status}" FontSize="12"
                                           TextColor="{StaticResource HabitGreenDark}" />
                                </Border>
                                <Border Style="{StaticResource Badge}" IsVisible="{Binding IsCompletedToday}">
                                    <Label Text="✓ Done today" FontSize="12"
                                           TextColor="{StaticResource HabitGreenDark}" />
                                </Border>
                            </HorizontalStackLayout>

                            <Button IsVisible="{Binding CanCompleteToday}"
                                    Text="Mark as complete"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,6,0,0"
                                    Clicked="OnHabitCompleteButton" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
