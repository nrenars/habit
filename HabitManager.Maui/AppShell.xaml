<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HabitManager.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HabitManager.Maui.Views"
    Title="Habit Manager"
    Shell.NavBarHasShadow="False"
    Shell.BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B211E}"
    Shell.TitleColor="{AppThemeBinding Light=#1A1F1C, Dark=#F1F4F2}"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B211E}"
    Shell.TabBarTitleColor="{StaticResource HabitGreen}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light=#6B746F, Dark=#9AA5A0}">

    <TabBar>
        <Tab Title="All" Icon="list.png">
            <ShellContent ContentTemplate="{DataTemplate views:HabitList}" />
        </Tab>

        <Tab Title="Completion" Icon="checkmark.png">
            <ShellContent ContentTemplate="{DataTemplate views:CompletedHabitList}" />
        </Tab>
    </TabBar>

</Shell>
