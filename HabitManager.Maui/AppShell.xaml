<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HabitManager.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HabitManager.Maui.Views"
    Title="Habits Manager">

    <TabBar>
        <Tab Title="All Habits" Icon="Resources/Images/list.png">
             <ShellContent ContentTemplate="{DataTemplate views:HabitList}"/>
        </Tab>

        <Tab Title="Completed Today" Icon="Rsources/Images/checkmark.png">
             <ShellContent ContentTemplate="{DataTemplate views:NewHabit}"/>
        </Tab>

    </TabBar>

</Shell>
